---
import "../styles/global.css";

const {
  title = "Orvalta",
  description = "Read-only Astro frontend for WordPress content."
} = Astro.props;

const logoSrc = "https://orvalta.com/wp-content/uploads/2022/03/orv-org-150.png";

const navItems = [
  { label: "Home", href: "https://orvalta.com/" },
  { label: "Inside Orvalta", href: "https://orvalta.com/about-us/" },
  { label: "All Products", href: "https://orvalta.com/products/" },
  { label: "Case Studies", href: "/blog/" },
  { label: "Contact Us", href: "https://orvalta.com/contact-orvalta/" }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header class="site-header">
      <div class="site-shell header-shell">
        <a class="brand-wordmark" href="/blog/" aria-label="Orvalta Case Studies">
          <img
            class="brand-logo"
            src={logoSrc}
            alt="Orvalta"
            width="150"
            height="150"
            loading="eager"
            decoding="async"
          />
        </a>

        <nav class="site-nav" aria-label="Primary">
          {
            navItems.map((item) => (
              <a href={item.href} class={item.href === "/blog/" ? "is-active" : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>

        <div class="header-actions">
          <a
            class="catalog-link"
            href="mailto:hello@orvalta.com?subject=Download%20Catalog"
          >
            Download Catalog
          </a>

          <a
            class="search-link"
            href="https://orvalta.com/?s="
            aria-label="Search Orvalta"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
              <path d="M16 16L21 21" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
            </svg>
          </a>
        </div>
      </div>
    </header>

    <main class="page-shell site-shell">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-shell footer-grid">
        <div>
          <p class="footer-label">From Business to Branding</p>
          <p class="footer-copy">
            Editorial stories, print thinking, and brand details presented as a natural extension of the Orvalta experience.
          </p>
        </div>

        <div>
          <p class="footer-label">Contact us</p>
          <p class="footer-copy">Monday-Friday: 09 AM - 6 PM</p>
          <a class="footer-link" href="tel:+971545893747">+971 545 89 3747</a>
          <a class="footer-link" href="mailto:hello@orvalta.com">hello@orvalta.com</a>
        </div>

        <div>
          <p class="footer-label">Menu</p>
          <div class="footer-menu">
            {
              navItems.map((item) => (
                <a class="footer-link" href={item.href}>
                  {item.label}
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </footer>

    <a
      class="whatsapp-float"
      href="https://wa.me/971521287700"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Chat on WhatsApp"
    >
      <span class="whatsapp-float__icon" aria-hidden="true">
        <svg viewBox="0 0 32 32">
          <path fill="currentColor" d="M16.02 3.2c-7.08 0-12.81 5.68-12.81 12.68 0 2.24.59 4.43 1.71 6.35L3 29l6.99-1.82a12.89 12.89 0 0 0 6.03 1.53h.01c7.07 0 12.8-5.68 12.8-12.68 0-3.39-1.33-6.58-3.73-8.96a12.9 12.9 0 0 0-9.08-3.87Zm0 23.38h-.01a10.7 10.7 0 0 1-5.45-1.49l-.39-.23-4.15 1.08 1.11-4.03-.25-.41a10.5 10.5 0 0 1-1.62-5.48c0-5.81 4.78-10.54 10.76-10.54 2.88 0 5.58 1.1 7.61 3.1a10.39 10.39 0 0 1 3.15 7.44c0 5.82-4.79 10.56-10.76 10.56Zm5.89-7.91c-.32-.16-1.91-.94-2.2-1.05-.3-.11-.52-.16-.74.16-.22.31-.85 1.05-1.04 1.26-.19.21-.38.24-.7.08-.33-.16-1.37-.5-2.62-1.59-.96-.84-1.61-1.88-1.8-2.2-.19-.31-.02-.48.14-.64.15-.15.33-.39.49-.58.16-.18.21-.31.32-.52.1-.21.05-.39-.03-.55-.08-.16-.74-1.76-1.01-2.41-.27-.64-.54-.56-.74-.57h-.63c-.22 0-.57.08-.87.39-.3.31-1.14 1.1-1.14 2.67 0 1.57 1.16 3.1 1.32 3.31.16.21 2.27 3.62 5.61 4.92.79.31 1.4.5 1.88.64.79.25 1.52.21 2.09.13.64-.09 1.91-.78 2.18-1.54.27-.76.27-1.41.19-1.54-.08-.13-.29-.21-.61-.37Z"/>
        </svg>
      </span>
      <span>How can I help you?</span>
    </a>
  </body>
</html>
