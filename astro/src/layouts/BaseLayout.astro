---
import "../styles/global.css";

const {
  title = "Orvalta",
  description = "Read-only Astro frontend for WordPress content."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <main class="page-shell">
      <slot />
    </main>
  </body>
</html>
