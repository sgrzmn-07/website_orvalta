---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Orvalta Astro Preview" description="Minimal Astro frontend reading from WordPress.">
  <section class="page-card">
    <p class="eyebrow">Phase 2</p>
    <h1>Orvalta Astro Frontend</h1>
    <p class="lede">
      This is a minimal read-only Astro app that pulls published blog posts from the live WordPress REST API.
    </p>
    <p style="margin-top: 1.75rem;">
      <a href="/blog/">View the blog index</a>
    </p>
  </section>
</BaseLayout>
