---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  formatPostDate,
  getAllPosts,
  getPostIntro
} from "../../lib/wordpress.js";

const posts = await getAllPosts();
const [featuredPost, secondaryPost, ...archivePosts] = posts;
---

<BaseLayout
  title="Case Studies | Orvalta"
  description="Editorial case studies from Orvalta, powered by WordPress and rendered in Astro."
>
  <section class="case-page-hero">
    <div class="case-page-hero__heading">
      <h1>Case Studies</h1>
      <p class="case-page-hero__tagline">
        Through a unique combination of design disciplines and expert operations. We deliver you - Happiness
      </p>
    </div>
  </section>

  <section class="case-editorial-intro">
    <div class="case-editorial-intro__grid">
      <div>
        <p class="eyebrow">Business Stories</p>
        <h2 class="case-editorial-intro__title">Power of A Brand</h2>
        <p class="case-editorial-intro__subhead">
          See how the smartest brands shape customer behavior through colors, messages, and meaning.
        </p>
      </div>

      <div class="case-editorial-intro__copy">
        <p>
          In Orvalta Case Studies, we break down how brands build recognition and turn those lessons into practical ideas for your packaging, print, and uniforms.
        </p>
        <p>
          This page is powered by your live WordPress posts, but structured as an editorial destination instead of a standard archive.
        </p>
      </div>
    </div>
  </section>

  {
    featuredPost && (
      <section class="case-showcase">
        <div class="case-showcase__visual">
          <p class="case-showcase__eyebrow">Brand Story</p>
          <div class="case-showcase__panel">
            <p class="case-showcase__topic">Red &amp; Yellow</p>
            <h2 class="case-showcase__panel-title" set:html={featuredPost.title?.rendered || "Untitled post"} />
            <p class="case-showcase__panel-copy">{getPostIntro(featuredPost)}</p>
          </div>
        </div>

        <div class="case-showcase__stories">
          <article class="case-story-teaser case-story-teaser--primary">
            <p class="case-story-teaser__index">1. Featured Case</p>
            <h3 class="case-story-teaser__title">
              <a href={`/blog/${featuredPost.slug}/`} set:html={featuredPost.title?.rendered || "Untitled post"} />
            </h3>
            <p class="case-story-teaser__meta">{formatPostDate(featuredPost.date)}</p>
            <p class="case-story-teaser__copy">{getPostIntro(featuredPost)}</p>
            <a class="learn-more" href={`/blog/${featuredPost.slug}/`}>Learn more</a>
          </article>

          {
            secondaryPost && (
              <article class="case-story-teaser">
                <p class="case-story-teaser__index">2. Business Story</p>
                <h3 class="case-story-teaser__title">
                  <a href={`/blog/${secondaryPost.slug}/`} set:html={secondaryPost.title?.rendered || "Untitled post"} />
                </h3>
                <p class="case-story-teaser__meta">{formatPostDate(secondaryPost.date)}</p>
                <p class="case-story-teaser__copy">{getPostIntro(secondaryPost)}</p>
                <a class="learn-more" href={`/blog/${secondaryPost.slug}/`}>Learn more</a>
              </article>
            )
          }
        </div>
      </section>
    )
  }

  <section class="case-archive">
    {
      archivePosts.length === 0 ? (
        <p class="empty-state">More published case studies will appear here as new WordPress posts go live.</p>
      ) : (
        <div class="case-archive__rows">
          {archivePosts.map((post, index) => (
            <article class="case-archive-row">
              <div class="case-archive-row__label">
                <p class="case-archive-row__number">{String(index + 3).padStart(2, "0")}</p>
                <p class="case-archive-row__date">{formatPostDate(post.date)}</p>
              </div>

              <div class="case-archive-row__content">
                <p class="eyebrow">Business Story</p>
                <h2 class="case-archive-row__title">
                  <a href={`/blog/${post.slug}/`} set:html={post.title?.rendered || "Untitled post"} />
                </h2>
              </div>

              <div class="case-archive-row__summary">
                <p class="case-archive-row__copy">{getPostIntro(post)}</p>
                <a class="learn-more" href={`/blog/${post.slug}/`}>Learn more</a>
              </div>
            </article>
          ))}
        </div>
      )
    }
  </section>

  <section class="case-brand-band">
    <div class="case-brand-band__grid">
      <div class="case-brand-band__headline">
        <p class="eyebrow">From Business to Branding</p>
        <h2 class="case-brand-band__title">Thoughtful stories for practical brand decisions.</h2>
      </div>

      <div class="case-brand-band__detail">
        <p>
          Every case study remains read-only and sourced from the live WordPress API, while the presentation here is shaped to feel like the existing Orvalta website.
        </p>
        <a class="learn-more" href="mailto:hello@orvalta.com">Contact us</a>
      </div>
    </div>
  </section>
</BaseLayout>
