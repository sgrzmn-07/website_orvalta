---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  formatPostDate,
  getAllPosts,
  getPostIntro
} from "../../lib/wordpress.js";

const posts = await getAllPosts();
const [featuredPost, ...remainingPosts] = posts;
const totalStories = posts.length;
---

<BaseLayout
  title="Case Studies | Orvalta"
  description="Editorial case studies from Orvalta, powered by WordPress and rendered in Astro."
>
  <section class="case-landing-hero">
    <div class="case-landing-hero__grid">
      <div>
        <p class="eyebrow">Business Stories</p>
        <h1 class="case-landing-hero__title">Case Studies</h1>
      </div>

      <div class="case-landing-hero__support">
        <p>
          A curated look at how brand decisions show up in print, packaging, uniforms, and everyday customer experience.
        </p>
        <p>
          Built like a branded landing page rather than a standard archive, this space turns live WordPress posts into a slower, more editorial Orvalta experience.
        </p>
      </div>
    </div>

    <div class="case-landing-summary">
      <div class="case-landing-summary__lead">
        <p class="section-kicker">From Business to Branding</p>
        <p class="case-landing-summary__text">
          Through a mix of brand observation, print thinking, and operational detail, these stories explain how visual consistency turns into trust.
        </p>
      </div>

      <div class="case-landing-summary__meta">
        <div>
          <span class="summary-label">Stories</span>
          <strong>{String(totalStories).padStart(2, "0")}</strong>
        </div>
        <div>
          <span class="summary-label">Format</span>
          <strong>Editorial</strong>
        </div>
        <div>
          <span class="summary-label">Source</span>
          <strong>WordPress</strong>
        </div>
      </div>
    </div>
  </section>

  {
    featuredPost && (
      <section class="case-featured">
        <div class="case-featured__rail">
          <p class="section-kicker">Featured Case</p>
          <div class="case-featured__number">01</div>
          <div class="case-featured__meta">
            <span>{formatPostDate(featuredPost.date)}</span>
            <span>Case Study</span>
          </div>
        </div>

        <div class="case-featured__content">
          <p class="section-kicker">Newest Story</p>
          <h2 class="case-featured__title">
            <a href={`/blog/${featuredPost.slug}/`} set:html={featuredPost.title?.rendered || "Untitled post"} />
          </h2>
          <p class="case-featured__excerpt">{getPostIntro(featuredPost)}</p>
          <a class="learn-more" href={`/blog/${featuredPost.slug}/`}>Learn more</a>
        </div>

        <aside class="case-featured__aside">
          <div>
            <p class="section-kicker">Story Focus</p>
            <p class="aside-copy">
              The lead story sits in its own oversized section, giving the newest WordPress post the same sense of emphasis you would expect from a flagship case study page.
            </p>
          </div>

          <div class="case-featured__slug">/{featuredPost.slug}/</div>
        </aside>
      </section>
    )
  }

  <section class="case-archive">
    <div class="case-archive__header">
      <div>
        <p class="eyebrow">Editorial Archive</p>
        <h2 class="case-archive__title">More Case Studies</h2>
      </div>

      <p class="case-archive__intro">
        The remaining stories are presented as large horizontal reading blocks with quieter metadata, generous spacing, and a more premium editorial rhythm.
      </p>
    </div>

    {
      remainingPosts.length === 0 ? (
        <p class="empty-state">More published case studies will appear here as new WordPress posts go live.</p>
      ) : (
        <div class="case-bands">
          {remainingPosts.map((post, index) => (
            <article class="case-band">
              <div class="case-band__rail">
                <div class="case-band__number">{String(index + 2).padStart(2, "0")}</div>
                <div class="case-band__date">{formatPostDate(post.date)}</div>
              </div>

              <div class="case-band__body">
                <p class="section-kicker">Business Story</p>
                <h3 class="case-band__title">
                  <a href={`/blog/${post.slug}/`} set:html={post.title?.rendered || "Untitled post"} />
                </h3>
              </div>

              <div class="case-band__summary">
                <p class="case-band__excerpt">{getPostIntro(post)}</p>
                <a class="learn-more" href={`/blog/${post.slug}/`}>Learn more</a>
              </div>
            </article>
          ))}
        </div>
      )
    }
  </section>

  <section class="case-closing-note">
    <p class="section-kicker">Orvalta Notes</p>
    <p class="case-closing-note__text">
      Each case study remains read-only and sourced from the live WordPress API, while the presentation here is shaped to feel like a dedicated editorial front door for the Orvalta brand.
    </p>
  </section>
</BaseLayout>
